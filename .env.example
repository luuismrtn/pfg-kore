# Puerto del servidor backend en desarrollo
PORT=3000

# Configuración del motor de recuperación RAG (Generación Aumentada por Recuperación)
RAG_USE_VECTOR_SEARCH=true
RAG_SEMANTIC_TOP_K=20
RAG_FINAL_EXERCISE_POOL_SIZE=10
RAG_MAX_SEMANTIC_TOP_K=110
RAG_MAX_FINAL_EXERCISE_POOL_SIZE=48

# URL de la API del Backend (Usado por el Frontend)
VITE_API_BASE_URL=http://localhost:3000/api
